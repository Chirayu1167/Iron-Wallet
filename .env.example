# Copy to .env and fill in your own credentials.
# OTP sending is optional — if Twilio vars are unset, otp_server.py falls back and logs OTP to console.
ACCOUNT_SID=
AUTH_TOKEN=
TWILIO_PHONE=
# Gemini proxy — set here so POST /assistant (otp_server.py:484) works. Never expose in js/config.js.
GEMINI_API_KEY=
# CORS — comma-separated allowlist, or * for dev. Example: https://ironwallet.app,http://localhost:3000
CORS_ORIGINS=*
# Keep-alive self-ping (keeps Render free tier awake; pings public URL every 10 min)
KEEPALIVE_ENABLED=true
KEEPALIVE_INTERVAL_S=600
# KEEPALIVE_URL= (optional override; defaults to RENDER_EXTERNAL_URL provided by Render)
# Periodic self-repair sweep (expires stale preparations, sweeps dead sessions)
REPAIR_ENABLED=true
REPAIR_INTERVAL_S=3600
