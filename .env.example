# Copy to .env and fill in your own credentials.
# OTP sending is optional — if Twilio vars are unset, otp_server.py falls back and logs OTP to console.
ACCOUNT_SID=
AUTH_TOKEN=
TWILIO_PHONE=
# Gemini proxy — set here so POST /assistant (otp_server.py:484) works. Never expose in js/config.js.
GEMINI_API_KEY=
# CORS — comma-separated allowlist, or * for dev. Example: https://ironwallet.app,http://localhost:3000
CORS_ORIGINS=*
